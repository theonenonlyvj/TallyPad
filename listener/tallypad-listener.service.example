[Unit]
Description=TallyPad button press listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path to wherever you cloned the repo.
ExecStart=/usr/bin/python3 /opt/TallyPad/listener/ingest.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
